{
  "name": "ultraforce-plasmo",
  "version": "0.5.0",
  "type": "module",
  "displayName": "UltraForce for Salesforce",
  "description": "Modern Salesforce metadata search and management tool",
  "author": "UltraForce Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:e2e": "PLASMO_PUBLIC_E2E=true plasmo build",
    "package": "plasmo package",
    "build:package": "pnpm build && pnpm package",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:e2e": "pnpm build:e2e && playwright test",
    "type-check": "tsc --noEmit",
    "release:patch": "node scripts/bump-version.mjs patch",
    "release:minor": "node scripts/bump-version.mjs minor",
    "release:major": "node scripts/bump-version.mjs major",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "keywords": [
    "salesforce",
    "chrome-extension",
    "metadata",
    "react"
  ],
  "license": "MIT",
  "manifest": {
    "default_locale": "en",
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "commands": {
      "toggle-search": {
        "suggested_key": {
          "default": "Ctrl+B",
          "mac": "Command+B"
        },
        "description": "__MSG_toggleSearch__"
      }
    },
    "permissions": [
      "storage",
      "activeTab",
      "tabs",
      "cookies"
    ],
    "host_permissions": [
      "https://*.salesforce.com/*",
      "https://*.salesforce-setup.com/*",
      "https://*.visual.force.com/*",
      "https://*.visualforce.com/*",
      "https://*.lightning.force.com/*",
      "https://*.my.salesforce.com/*",
      "https://*.force.com/*",
      "https://*.sfcrmapps.cn/*",
      "https://*.sfcrmproducts.cn/*",
      "https://*.setup.sfcrmproducts.cn/*",
      "https://*.setup.sfcrmapps.cn/*",
      "https://login.salesforce.com/*",
      "https://test.salesforce.com/*"
    ],
    "storage": {
      "managed_schema": "/managed_schema.json"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/fonts/inter-latin.woff2",
          "assets/fonts/inter-latin-ext.woff2"
        ],
        "matches": [
          "https://*.salesforce.com/*",
          "https://*.visual.force.com/*",
          "https://*.visualforce.com/*",
          "https://*.lightning.force.com/*",
          "https://*.my.salesforce.com/*",
          "https://*.salesforce-setup.com/*",
          "https://*.force.com/*",
          "https://*.my.salesforce-sites.com/*",
          "https://*.salesforce-communities.com/*",
          "https://*.sandbox.my.salesforce.com/*",
          "https://*.scratch.my.salesforce.com/*",
          "https://*.sfcrmapps.cn/*",
          "https://*.lightning.sfcrmapps.cn/*",
          "https://*.visual.sfcrmapps.cn/*",
          "https://*.my.sfcrmapps.cn/*",
          "https://*.sandbox.my.sfcrmapps.cn/*",
          "https://*.sfcrmproducts.cn/*",
          "https://*.lightning.sfcrmproducts.cn/*",
          "https://*.visual.sfcrmproducts.cn/*",
          "https://*.my.sfcrmproducts.cn/*",
          "https://*.sandbox.my.sfcrmproducts.cn/*",
          "https://*.setup.sfcrmproducts.cn/*",
          "https://*.setup.sfcrmapps.cn/*"
        ]
      }
    ]
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "plasmo": "^0.90.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "vitest-chrome": "0.1.0",
    "yaml": "2.9.0"
  }
}
